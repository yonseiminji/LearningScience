# Tutor Agent — Google Gemini
# Set these in Vercel: Project Settings → Environment Variables.
# They are read by api/tutor/* on the server. The browser never sees them.

GEMINI_API_KEY=
# Any Flash-class model; named here so it can be changed without a code deploy.
GEMINI_MODEL=gemini-2.0-flash

# Optional. The model that splits an assignment into steps. Falls back to
# GEMINI_MODEL when unset, so the two can be moved independently without
# either being left unconfigured.
PLANNER_GEMINI_MODEL=

# Optional. Seals the answer that travels with each question so the browser
# cannot read it. Falls back to a key derived from GEMINI_API_KEY, so the
# feature works without this; set it to rotate the two independently.
TUTOR_SECRET=

# ── Preview 전용. Production에는 두지 마세요 ──────────────────────────────
# Vercel → Settings → Environment Variables에서 Preview에만 체크합니다.

# Logs what was sent to the model and what came back, to Runtime Logs only.
# The raw model text holds the answers, so this must stay off in Production.
# Read it with: vercel logs <deployment-url>
TUTOR_DEBUG=

# Client-side, so it is baked into the build. Stops the quiet fallback to the
# demo questions, letting a broken route or a refused method show itself
# instead of looking like a working screen.
VITE_TUTOR_STRICT=
